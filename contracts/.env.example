# Copy to .env.local (gitignored) and fill in.

# Deployer / attester key. Fund this address from the MST Testnet Faucet
# (https://faucet.mstblockchain.com) before running deploy:testnet.
PRIVATE_KEY=

# Optional — only needed for `npm run verify:testnet` source verification on MSTScan.
MSTSCAN_API_KEY=

# Optional — `npm run grant-roles:*` grants ATTESTER_ROLE + ISSUER_ROLE to this
# address instead of leaving them with the deployer. Leave empty for the
# hackathon setup, where one funded key runs everything.
BACKEND_SIGNER_ADDRESS=

# Optional — off-chain pointer stored beside the real model hash by
# `npm run register-model:*` (an IPFS CID for the manifest, or a URL to the
# model card). Empty uses a descriptive manifest:// default.
MODEL_URI=

# Optional — path to the weights manifest that register-model reads the hash
# from. Empty uses contracts/model-manifest.json, which is what
# `python -m app.ml.manifest --json ../contracts/model-manifest.json` writes
# when run from backend/.
MODEL_MANIFEST_PATH=
