# Copy to backend/.env (gitignored). Nothing here is committed.

# --- Database -----------------------------------------------------------
# SQLite by default for the hackathon build. Swap to a Postgres URL later
# with zero code changes (SQLAlchemy handles both).
DATABASE_URL=sqlite:///./anemiascan.db

# --- MST chain ------------------------------------------------------------
MST_NETWORK=testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com

# Contract addresses — printed by `npm run deploy:testnet` in contracts/.
MST_ANEMIA_REGISTRY_ADDRESS=
MST_CARE_POOL_ADDRESS=

# Mock model hash — printed by `npm run grant-roles:testnet` in contracts/.
# Only needed when INFERENCE_PROVIDER=mock.
MST_MOCK_MODEL_HASH=

# --- Inference --------------------------------------------------------
# "real" runs the AnemiaScan V3.1 calibrated bundle (app/ml/model_assets/ —
# weights gitignored, JSON configs tracked; see
# app/ml/model_assets/BUNDLE_README.md and ../MODEL_CARD.md); "mock" uses the
# deterministic synthetic provider and needs no model weights.
INFERENCE_PROVIDER=real
ML_DEVICE=cpu

# Optional override for the real model's on-chain model_hash. Leave EMPTY in
# normal use.
#
# This is no longer keccak256 of a fixed text tag. The hash is now derived from
# the weights themselves: app/ml/manifest.py sha256s every asset the runtime
# loads, serialises the (path, sha256, bytes) triples in canonical sorted form,
# and takes keccak256 of that text. Change one byte of one checkpoint — or one
# threshold in runtime_config.json — and the hash changes, which is the point:
# a text tag was identical whatever bytes were actually installed, so it could
# not detect a swapped or silently-retrained model. Setting this variable
# overrides that derivation, so only set it to pin a hash you have verified
# against `python -m app.ml.manifest`.
MST_REAL_MODEL_HASH=

# Refuse to anchor a screening whose model hash is not registered and active on
# AnemiaRegistry, instead of broadcasting a transaction that reverts with
# ModelNotFound and burns gas for a result the user has already been shown.
# Register the real hash first with `npm run register-model:testnet` in
# contracts/ (grant-roles registers only the MOCK hash).
REQUIRE_REGISTERED_MODEL=true

# --- Uploads -------------------------------------------------------------
# Neither FastAPI nor Starlette caps a FILE part — Starlette's 1MB
# max_part_size applies only to non-file form fields — so without this a 28MB
# upload was accepted and fully buffered in memory. 12MB.
MAX_UPLOAD_BYTES=12582912
# Comma-separated. The declared Content-Type is client-controlled, so the
# leading bytes are sniffed as well and a mismatch between the two is itself
# rejected (app/uploads.py).
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# --- Auth (Firebase ID tokens) --------------------------------------------
# REQUIRED. POST /inference/predict verifies an `Authorization: Bearer <Firebase
# ID token>` header on every call: the RS256 signature against Google's
# securetoken certificates, then iss/exp/iat/sub, and — critically — that `aud`
# equals this project id. Checking `aud` is what stops a token minted for some
# other Firebase project being replayed here.
#
# This MUST be the same project as the frontend's VITE_FIREBASE_PROJECT_ID (see
# the repo-root .env.example). If they differ, every screening is rejected with
# 401, because the token's audience is the frontend's project and not this one.
# If it is unset the endpoint returns 503 rather than silently accepting
# anything.
#
# Verification is unconditional — there is deliberately no switch to disable
# it, because a screening endpoint that can be opened by an env var is one bad
# deploy away from being open. Tests substitute the auth dependency directly
# via FastAPI's dependency_overrides instead.
FIREBASE_PROJECT_ID=

# --- Gemini explainer (optional) ------------------------------------------
# POST /inference/explain turns an ALREADY-COMPUTED result into a short
# plain-language paragraph. It never sees the image and cannot change the
# decision, the probability, the database row or the on-chain commitment.
# Leave the key empty and the endpoint honestly reports itself unavailable and
# the UI hides the section — it never fabricates an explanation locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Backend signer(s) ----------------------------------------------------
# Hackathon-demo simplification: the backend holds the private key(s) that
# call registerScreening (ATTESTER_ROLE), issueCarePass (ISSUER_ROLE), and
# redeemCarePass (must hold CLINIC_ROLE). In a production build, sponsor and
# clinic actions would instead be signed client-side via BridgeKey and never
# touch this key at all — see docs/DEPLOYMENT.md.
#
# For the hackathon, reuse contracts/.env.local's PRIVATE_KEY here (that
# deployer key already holds every role from the constructor).
MST_ATTESTER_PRIVATE_KEY=
MST_ISSUER_PRIVATE_KEY=
MST_CLINIC_PRIVATE_KEY=

# --- Auth (sponsor/clinic wallets) ----------------------------------------
# Wallet challenge-response, unrelated to the Firebase patient sign-in above.
WALLET_AUTH_NONCE_TTL_SECONDS=300
# HMAC secret for the session tokens issued after signature verification.
# Change this for anything beyond a local demo.
SESSION_SECRET=dev-insecure-change-me
SESSION_TTL_SECONDS=3600

# --- CORS (comma-separated origins; * only for local dev) -----------------
# Vite is configured to use port 3000 in this repository. Keep 5173 for
# developers using Vite's default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
