# Copy to backend/.env (gitignored). Nothing here is committed.

# --- Database -----------------------------------------------------------
# SQLite by default for the hackathon build. Swap to a Postgres URL later
# with zero code changes (SQLAlchemy handles both).
DATABASE_URL=sqlite:///./anemiascan.db

# --- MST chain ------------------------------------------------------------
MST_NETWORK=testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com

# Contract addresses — printed by `npm run deploy:testnet` in contracts/.
MST_ANEMIA_REGISTRY_ADDRESS=
MST_CARE_POOL_ADDRESS=

# Mock model hash — printed by `npm run grant-roles:testnet` in contracts/.
# Only needed when INFERENCE_PROVIDER=mock.
MST_MOCK_MODEL_HASH=

# --- Inference --------------------------------------------------------
# "real" runs the AnemiaScan V4 calibrated bundle (app/ml/model_assets/,
# gitignored — install it with scripts/install_v4_bundle.py); "mock" uses the
# deterministic synthetic provider and needs no model weights.
INFERENCE_PROVIDER=real
ML_DEVICE=auto
ML_MAX_UPLOAD_BYTES=10485760
# Optional override for the real model's on-chain model_hash; leave empty to
# use the installed V4 bundle's deterministic SHA-256 model hash.
MST_REAL_MODEL_HASH=

# --- Backend signer(s) ----------------------------------------------------
# Hackathon-demo simplification: the backend holds the private key(s) that
# call registerScreening (ATTESTER_ROLE), issueCarePass (ISSUER_ROLE), and
# redeemCarePass (must hold CLINIC_ROLE). In a production build, sponsor and
# clinic actions would instead be signed client-side via BridgeKey and never
# touch this key at all — see docs/DEPLOYMENT.md.
#
# For the hackathon, reuse contracts/.env.local's PRIVATE_KEY here (that
# deployer key already holds every role from the constructor).
MST_ATTESTER_PRIVATE_KEY=
MST_ISSUER_PRIVATE_KEY=
MST_CLINIC_PRIVATE_KEY=

# --- Auth -------------------------------------------------------------
WALLET_AUTH_NONCE_TTL_SECONDS=300

# --- CORS (comma-separated origins; * only for local dev) -----------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
